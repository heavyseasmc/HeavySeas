{
  "schemaVersion": 1,
  "id": "heavyseas",
  "version": "${version}",
  "name": "Heavy Seas",
  "description": "6–8 人谈判游戏。",
  "authors": ["Heavy Seas contributors"],
  "license": "MIT",
  "environment": "*",
  "custom": {
    "cardinal-components": ["heavyseas:game"]
  },
  "entrypoints": {
    "main": ["io.github.heavyseasmc.mod.HeavySeasMod"],
    "client": ["io.github.heavyseasmc.mod.client.HeavySeasClient"],
    "cardinal-components": ["io.github.heavyseasmc.mod.state.GameComponents"]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": ">=${fabric_api_version}",
    "cardinal-components-base": ">=${cca_version}",
    "cardinal-components-world": ">=${cca_version}"
  },
  "suggests": {
    "voicechat": "*"
  }
}
