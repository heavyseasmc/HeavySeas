    "rain":           { "start": 8,  "end": 40,  "rain": true,  "thunder": false, "time": 13000 },
    "storm":          { "start": 5,  "end": 25,  "rain": true,  "thunder": true,  "time": 14000 },
    "huge_wave":      { "start": 7,  "end": 35,  "rain": false, "thunder": false, "time": 12000 },
    "gale":           { "start": 12, "end": 60,  "rain": false, "thunder": false, "time": 6000 },
