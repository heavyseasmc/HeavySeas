#!/usr/bin/env bash
#
# 推送前检查。启用（每个克隆只需一次）：
#   git config core.hooksPath .githooks
#
# 为什么是 pre-push 而不是 pre-commit：
#   提交是本地的、可以重来；**推送是不可逆的**——推上去的东西即使随后强推覆盖，
#   也已经离开了这台机器。所以重的检查放在这里，提交保持快。
#
# 绕过：git push --no-verify（请三思：上一次跳过检查的代价是重建整个仓库历史）

set -uo pipefail

check="$(git rev-parse --show-toplevel)/docs/tools/prepush.sh"

if [[ -f "$check" ]]; then
  bash "$check" || {
    echo
    echo "推送已中止。确需绕过时：git push --no-verify（请三思）"
    exit 1
  }
else
  echo "提示：未找到维护者本地检查脚本，跳过推送前检查（普通克隆里属正常）。"
fi
